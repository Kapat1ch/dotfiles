{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
   "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "cyan",
      "2": "blue"
    },
    "padding": {
      "top": 4,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " 󰄾 ",
    "color": {
      "separator": "bright_black"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[36m╭─\u001b[0m \u001b[1;36mesen\u001b[0;34m@\u001b[1;34mnobara-pc\u001b[0m"
    },
    {
      "type": "os",
      "key": "\u001b[36m│\u001b[0m  os  ",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "\u001b[36m│\u001b[0m 󰒋 ker ",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "\u001b[36m│\u001b[0m 󱑂 up  ",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "\u001b[36m│\u001b[0m 󰨇 wm  ",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "\u001b[36m│\u001b[0m  ter ",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "\u001b[36m├─ Спеки ──────────────────────\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "\u001b[36m│\u001b[0m  cpu ",
      "keyColor": "cyan"
    },
    {
      "type": "gpu",
      "key": "\u001b[36m│\u001b[0m 󰢮 gpu ",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "\u001b[36m│\u001b[0m  mem ",
      "keyColor": "cyan"
    },
    {
      "type": "disk",
      "key": "\u001b[36m│\u001b[0m 󰋊 dsk ",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "\u001b[36m╰──────────────────────────────\u001b[0m"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
